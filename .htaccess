Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Somente a dashboard, os assets publicos e os endpoints podem ser acessados.
    RewriteRule ^$ - [L]
    RewriteRule ^index\.php$ - [L]
    RewriteRule ^login/?$ login.php [L,QSA]
    RewriteRule ^cadastro/?$ register.php [L,QSA]
    RewriteRule ^esqueci-senha/?$ forgot-password.php [L,QSA]
    RewriteRule ^redefinir-senha/?$ reset-password.php [L,QSA]
    RewriteRule ^(login|register|forgot-password|reset-password)\.php$ - [L]
    RewriteRule ^static/css/dashboard\.css$ - [L]
    RewriteRule ^static/css/auth\.css$ - [L]
    RewriteRule ^static/js/dashboard\.js$ - [L]
    RewriteRule ^static/js/auth\.js$ - [L]
    RewriteRule ^static/js/vendor/chart\.umd\.min\.js$ - [L]
    RewriteRule ^api/device/(current|history|status|alerts|ingest)\.php$ - [L]
    RewriteRule ^api/auth/(register|login|logout|me|forgot-password|reset-password)\.php$ - [L]
    RewriteRule ^api/reservoirs/(index|rename)\.php$ - [L]
    RewriteRule ^api/devices/(validate-pairing|connect|unlink)\.php$ - [L]
    RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
