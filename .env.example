APP_ENV=development
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
DEVICE_OFFLINE_AFTER_SECONDS=90

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=recursos_hidricos
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
# Usado somente quando DB_CONNECTION=sqlite (desenvolvimento/testes).
DB_SQLITE_PATH=

MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=sm-wa-php-subscriber
MQTT_TOPIC=sm-wa/+/data
MQTT_STATUS_TOPIC=sm-wa/+/status
MQTT_QOS=1
MQTT_KEEP_ALIVE_SECONDS=30
MQTT_CONNECT_TIMEOUT_SECONDS=10
MQTT_SOCKET_TIMEOUT_SECONDS=5
MQTT_MAX_PAYLOAD_BYTES=4096
MQTT_RECONNECT_MIN_SECONDS=1
MQTT_RECONNECT_MAX_SECONDS=30
MQTT_RECONNECT_RESET_AFTER_SECONDS=60
MQTT_ALLOWED_DEVICE_IDS=ESP32_001
MQTT_TLS=false
MQTT_TLS_VERIFY_PEER=true
MQTT_TLS_CA_FILE=
