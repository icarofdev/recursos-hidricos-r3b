# ==============================================================================
# Recursos Hídricos R3B — Configuração de Ambiente
# Copie este arquivo para .env e preencha com seus dados reais.
# NUNCA versione o arquivo .env preenchido!
# ==============================================================================

# --- Aplicação ---
APP_ENV=production
APP_DEBUG=false
APP_URL=https://seu-dominio-ou-ip.com
APP_PORT=80
APP_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=warning
# Chave aleatória de pelo menos 32 bytes para hashes internos/rate limiting
APP_KEY=gere_uma_chave_aleatoria_forte_e_exclusiva
# Diretório gravável e não público usado pelas sessões nativas do PHP
SESSION_SAVE_PATH=/var/lib/hidra-r3b/sessions

# --- Banco de Dados (MariaDB / MySQL local na VPS) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=recursos_hidricos
DB_USER=recursos_user
DB_PASSWORD=defina_uma_senha_forte_aqui
DB_CHARSET=utf8mb4
DB_TIMEOUT=5
# Compatibilidade legada
DB_DATABASE=recursos_hidricos
DB_USERNAME=recursos_user
# Usado somente em testes/desenvolvimento local com SQLite
DB_SQLITE_PATH=

# --- Autenticação e recuperação de senha ---
# O cookie de sessão é HttpOnly, SameSite=Lax e Secure quando APP_URL usa HTTPS.
PASSWORD_RESET_TTL_MINUTES=20

# E-mail transacional Brevo (somente backend)
BREVO_API_KEY=chave_brevo_apenas_no_servidor
BREVO_SENDER_EMAIL=monitoramento@seu-dominio.com.br
BREVO_SENDER_NAME="Hidra R3B"

# --- Ingestão IoT (SM-WU V5.10) ---
DEVICE_INGEST_PATH=/api/device/ingest.php
# Chave/token mestre de autenticação da ingestão
DEVICE_TOKEN_SECRET=defina_um_token_forte_aqui_ex_64_chars
# Compatibilidade legada
SMWU_DEVICE_TOKEN=defina_um_token_forte_aqui_ex_64_chars

# Tokens específicos por dispositivo (opcional, formato: id:token,id:token)
DEVICE_TOKENS=1:token_exclusivo_dispositivo_1

# Dispositivos autorizados (IDs separados por vírgula)
DEVICE_ALLOWED_IDS=1
MQTT_ALLOWED_DEVICE_IDS=1

# Permitir ingestão via HTTP direto da Internet (necessário pois SM-WU V5.10 não suporta TLS)
ALLOW_HTTP_INGEST=true

# Proteção contra duplicatas rápidas / replay de rede (em segundos)
TELEMETRY_MIN_INTERVAL_SECONDS=3

# Tempo de inatividade para considerar o sensor offline (em segundos)
DEVICE_OFFLINE_AFTER_SECONDS=90

# Rate Limit na ingestão PHP (máx requisições por janela de segundos por IP)
INGEST_RATE_LIMIT_MAX=30
INGEST_RATE_LIMIT_WINDOW=10

# Retenção de histórico (em dias, para rotina de limpeza diária)
TELEMETRY_RETENTION_DAYS=90

# Limite de tamanho máximo do payload JSON (em bytes)
MQTT_MAX_PAYLOAD_BYTES=4096

# --- MQTT Cloud (Opcional - caso utilize broker MQTT além do HTTP) ---
MQTT_HOST=r10116ac.ala.us-east-1.emqxsl.com
MQTT_PORT=8883
MQTT_USERNAME=smwa_device
MQTT_PASSWORD=
MQTT_CLIENT_ID=sm-wu-php-subscriber
MQTT_TOPIC=sm-wu/+/data
MQTT_STATUS_TOPIC=sm-wu/+/status
MQTT_QOS=1
MQTT_KEEP_ALIVE_SECONDS=30
MQTT_CONNECT_TIMEOUT_SECONDS=10
MQTT_SOCKET_TIMEOUT_SECONDS=5
MQTT_RECONNECT_MIN_SECONDS=1
MQTT_RECONNECT_MAX_SECONDS=30
MQTT_RECONNECT_RESET_AFTER_SECONDS=60
MQTT_TLS=true
MQTT_TLS_VERIFY_PEER=true
MQTT_TLS_CA_FILE=

# --- Compartilhamento protegido do Dashboard via HTTPS (Opcional) ---
DASHBOARD_SHARE_USERNAME=visitante
DASHBOARD_SHARE_PASSWORD=troque-por-uma-senha-forte
# Conta já cadastrada cujos reservatórios serão exibidos no acesso compartilhado
DASHBOARD_SHARE_USER_EMAIL=conta-compartilhada@seu-dominio.com.br
