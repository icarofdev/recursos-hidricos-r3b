# ==============================================================================
# Cronjobs — Recursos Hídricos R3B
# Copie para /etc/cron.d/recursos-hidricos (permissão 644, root)
# ==============================================================================

# Backup diário do MariaDB às 03:00 da madrugada
0 3 * * * root /var/www/recursos-hidricos-r3b/scripts/backup-db.sh >> /var/log/recursos-hidricos-backup.log 2>&1

# Limpeza de retenção de telemetria todo domingo às 04:00 da madrugada
0 4 * * 0 root /usr/bin/php /var/www/recursos-hidricos-r3b/scripts/cleanup-retention.php >> /var/log/recursos-hidricos-retention.log 2>&1
