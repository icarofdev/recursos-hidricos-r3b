# ==============================================================================
# Logrotate — Recursos Hídricos R3B
# Copie para /etc/logrotate.d/recursos-hidricos
# ==============================================================================

/var/log/recursos-hidricos-*.log {
    weekly
    missingok
    rotate 8
    compress
    delaycompress
    notifempty
    create 0640 root adm
}
