# ==============================================================================
# Sudoers de Privilégio Mínimo para o Usuário de Deploy — Recursos Hídricos R3B
# Copie para /etc/sudoers.d/recursos-hidricos-deploy (permissões 0440 root:root)
# ==============================================================================

# Permite ao usuário 'deploy' apenas testar e recarregar Nginx e PHP-FPM, sem senha:
deploy ALL=(ALL) NOPASSWD: /usr/sbin/nginx -t
deploy ALL=(ALL) NOPASSWD: /usr/bin/systemctl reload nginx
deploy ALL=(ALL) NOPASSWD: /usr/bin/systemctl reload php*-fpm
deploy ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart php*-fpm
deploy ALL=(ALL) NOPASSWD: /usr/bin/chown -R www-data\:www-data /var/www/recursos-hidricos-r3b
deploy ALL=(ALL) NOPASSWD: /usr/bin/chown -R deploy\:www-data /var/www/recursos-hidricos-r3b
