# ==============================================================================
# Configuração de Conexão com a VPS — Recursos Hídricos R3B
# Copie este arquivo para deploy/vps.env e preencha suas informações.
# O arquivo deploy/vps.env é ignorado pelo Git e NUNCA será versionado.
# ==============================================================================

# Endereço IP ou hostname público da VPS (sem http://)
VPS_HOST=seu_ip_ou_hostname

# Usuário SSH com privilégios para atualizar /var/www (ex: root ou ubuntu)
VPS_USER=root

# Porta SSH da VPS (padrão: 22)
VPS_PORT=22

# Caminho da chave SSH privada (opcional; se vazio, usa autenticação padrão/senha/agente)
# Exemplo Windows: C:\Users\SeuUsuario\.ssh\id_rsa
# Exemplo Linux: ~/.ssh/id_ed25519
VPS_SSH_KEY=

# Diretório raiz da aplicação na VPS
VPS_REMOTE_DIR=/var/www/recursos-hidricos-r3b

# Usuário e grupo do servidor web na VPS (para chown)
WEB_USER=www-data
WEB_GROUP=www-data

# Recarregar serviços automaticamente após o deploy (true ou false)
REMOTE_RELOAD_SERVICES=true

# Nome do serviço PHP-FPM na VPS (Ubuntu 22.04: php8.1-fpm; Ubuntu 24.04: php8.3-fpm; Debian 12: php8.2-fpm)
REMOTE_PHP_FPM_SERVICE=php8.2-fpm
